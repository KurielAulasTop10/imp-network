---
import PostPageContent from "@/components/PostPageContent";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createClient } from "@/prismicio";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/404");
}

const client = createClient();
const article = await client
	.getByUID("post", slug, { fetchOptions: { cache: "no-cache" } })
	.catch(() => null);

if (!article) {
	return Astro.redirect("/404");
}

interface MyAuthorData {
	uid?: string;
}

const myAuthorData = article.data.author as unknown as MyAuthorData;

if (!myAuthorData?.uid) {
	return Astro.redirect("/404");
}

const [author, ads] = await Promise.all([
	client.getByUID("author", myAuthorData.uid).catch(() => null),
	client.getAllByType("anuncio").catch(() => []),
]);

if (!author) {
	return Astro.redirect("/404");
}

/* if (!article?.data?.seo_description) {
	const editorContent = article.data.editor
		? JSON.stringify(article.data.editor)
		: "";
	const isFreeCategory = article.tags.includes("Grátis");

	/* await fetch(
		`${new URL(Astro.request.url).origin}/api/generate-ai`,
		{
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({
				title: article.data.titulo,
				article: editorContent,
				slug: slug,
				SEOOnly: isFreeCategory,
			}),
		},
	).catch(() => null);

} */

const adsSorted = ads.sort(() => Math.random() - 0.5);

const siteUrl = (Astro.site?.origin ?? "https://imperionetwork.fr").replace(/\/$/, "");
const articleUrl = `${siteUrl}/post/${slug}`;
const authorName = author.uid?.replaceAll("-", " ") ?? "Império Network";

const articleJsonLd = {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"@id": `${articleUrl}#article`,
	headline: article.data.titulo,
	description: article.data.seo_description ?? undefined,
	image: article.data.cover.url ? [article.data.cover.url] : undefined,
	datePublished: article.first_publication_date,
	dateModified: article.last_publication_date,
	inLanguage: "pt-BR",
	mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
	url: articleUrl,
	author: {
		"@type": "Person",
		name: authorName,
	},
	publisher: { "@id": `${siteUrl}/#organization` },
	keywords: article.tags?.length ? article.tags.join(", ") : undefined,
};
---

<BaseLayout title={article.data.titulo} description={article?.data?.seo_description} image={article.data.cover.url} jsonLd={articleJsonLd}>
	<PostPageContent
		client:idle
		article={article}
		author={author}
		adsSorted={adsSorted}
	/>
</BaseLayout>
